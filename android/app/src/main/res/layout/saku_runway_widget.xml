<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/runway_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/saku_widget_bg"
    android:padding="12dp">

    <!-- Top Row: Title + Countdown Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/runway_target_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Akhir Bulan / Gajian"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/runway_countdown_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/saku_badge_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="11 hari lagi"
            android:textColor="#3B82F6"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Metric Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/runway_daily_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 125.000"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="/ hari"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/runway_total_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saldo: Rp 2.450.000"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="normal" />
    </LinearLayout>

    <!-- Advice Box (Expands to fill remaining height gracefully) -->
    <LinearLayout
        android:id="@+id/runway_advice_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/saku_advice_bg"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/runway_advice_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belanja aman maksimal Rp 125.000/hari menuju tanggal target."
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="normal"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
